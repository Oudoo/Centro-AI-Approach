{
  "name": "Zoho Casual Leave Request",
  "version": "v1",
  "target_system": "Zoho People",
  "mcp_system": "zoho",
  "mcp_tool": "leave.request.casual",
  "intents": ["casual_leave_request"],
  "summary": "Submit a casual/emergency leave request to Zoho People.",
  "risk_level": "medium",
  "risk_assessment": "Deducts from your casual leave balance.",
  "endpoint": "/api/v2/leave/request",
  "auth": "zoho_oauth",
  "example_payload": {
    "leave_type": "Casual Leave"
  },
  "form_fields": [
    {
      "name": "start_date",
      "type": "date",
      "label": "Start Date"
    },
    {
      "name": "end_date",
      "type": "date",
      "label": "End Date"
    },
    {
      "name": "reason",
      "type": "textarea",
      "label": "Emergency Reason",
      "required": true
    }
  ],
  "min_role_required": "agent"
}
