# =============================================================================
# Aura (by Centro) — LOCAL preconfigured env (Ollama on Intel macOS)
# Copy to `.env`:   cp .env.local.example .env   (run from inside aura-by-centro/)
# =============================================================================
# Recommended engine: Ollama (one OpenAI-compatible endpoint serves chat AND
# embeddings, reliable on Intel CPUs). Start it with:
#     OLLAMA_KEEP_ALIVE=-1 ollama serve      # keeps the model warm = much faster
# and pull the models:
#     ollama pull qwen2.5:1.5b               # fast, great at grounded answers
#     ollama pull nomic-embed-text           # 768-dim embeddings (CAG + RAG)
#
# Prefer Msty instead? Set the URLs below to your Msty Local AI endpoint
# (usually http://localhost:10000/v1 — verify the port in Msty settings) and
# pull an embedding model in Msty. Everything else is identical.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ---- Local LLM (Ollama, OpenAI-compatible) ---------------------------------
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=local-no-key-required
# Fastest models for a CPU-only Mac (CAG + RAG supply the facts, so a small
# instruction model is ideal). Recommended default:
#   qwen2.5:1.5b   (best balance of speed + grounded quality)
#   qwen2.5:0.5b   (fastest)        llama3.2:1b   (fast)        gemma3:1b
LLM_MODEL=qwen2.5:1.5b
LLM_CONTEXT_WINDOW=8192
LLM_MAX_OUTPUT_TOKENS=768
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=300

# ---- Embeddings ------------------------------------------------------------
# CAG + RAG need a real embedding model. nomic-embed-text is 768-dim, matching
# EMBEDDING_DIM below. (Pull it in Ollama or Msty.)
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- Vector engine (Qdrant via Docker Desktop) -----------------------------
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_COLLECTION=aura_knowledge
SCHEMA_COLLECTION=aura_schemas

# ---- CAG -------------------------------------------------------------------
CAG_SIMILARITY_THRESHOLD=0.92
CAG_MAX_ENTRIES=2048

# ---- Auth (dev) ------------------------------------------------------------
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
SESSION_TTL_SECONDS=3600

# ---- Employee requests: storage + email (demo phase) -----------------------
# Submitted requests (leave, shift swap, break) are saved to SQLite and the
# team is notified by email. Leave SMTP_HOST blank to run in DEMO MODE: requests
# are still recorded + exportable, the email is just composed/logged not sent.
REQUEST_NOTIFY_EMAIL=mahmoud.hassan@centrocdx.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=aura@centrocdx.com
SMTP_USE_TLS=true

# ---- Frontend --------------------------------------------------------------
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_URL=http://localhost:8000
