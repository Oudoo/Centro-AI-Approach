# =============================================================================
# Aura (by Centro) — LOCAL preconfigured env for Msty Studio on Intel macOS
# Copy to `.env`:   cp .env.local.example .env
# =============================================================================
# Msty Studio exposes an OpenAI-compatible "Local AI" endpoint. Open Msty >
# Settings > Local AI and copy the exact Service Endpoint shown there. It is
# usually http://localhost:10000/v1 (Msty) — adjust the port if yours differs.
# If you'd rather use plain Ollama instead, set the URLs to http://localhost:11434/v1.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ---- Local LLM (your installed Gemma 4, 8B Q4_K_M) --------------------------
LLM_BASE_URL=http://localhost:10000/v1
LLM_API_KEY=local-no-key-required
# Use the model id exactly as Msty/Ollama lists it. Your two installed options:
#   gemma3:1b   (fast, light — good for a slow Intel CPU)
#   gemma4      (9.6GB / 8B — higher quality, slower on CPU)
LLM_MODEL=gemma3:1b
LLM_CONTEXT_WINDOW=8192
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=180

# ---- Embeddings ------------------------------------------------------------
# CAG + RAG need a real embedding model. Pull one in Msty (or `ollama pull
# nomic-embed-text`). nomic-embed-text is 768-dim, matching EMBEDDING_DIM below.
EMBEDDING_BASE_URL=http://localhost:10000/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- Vector engine (Qdrant via Docker Desktop) -----------------------------
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_COLLECTION=aura_knowledge
SCHEMA_COLLECTION=aura_schemas

# ---- CAG -------------------------------------------------------------------
CAG_SIMILARITY_THRESHOLD=0.92
CAG_MAX_ENTRIES=2048

# ---- Auth (dev) ------------------------------------------------------------
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
SESSION_TTL_SECONDS=3600

# ---- Frontend --------------------------------------------------------------
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_URL=http://localhost:8000
