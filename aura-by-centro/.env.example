# =============================================================================
# Aura (by Centro) — Environment Template
# Copy to `.env` and fill in real values. NEVER commit your populated .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                     # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
ALLOWED_ORIGINS=http://localhost:3000   # CSV of allowed CORS / WS origins

# -----------------------------------------------------------------------------
# Local Gemma-4 LLM (OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:1234/v1   # vLLM / Ollama / LM Studio compatible
LLM_API_KEY=local-no-key-required
LLM_MODEL=gemma-4
LLM_CONTEXT_WINDOW=262144               # 256K context window
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=120                 # seconds before OOM/latency fallback

# -----------------------------------------------------------------------------
# Embeddings (used by RAG ingestion + CAG semantic cache)
# -----------------------------------------------------------------------------
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-nomic
EMBEDDING_DIM=768

# -----------------------------------------------------------------------------
# Vector Engine (Qdrant by default; ChromaDB supported)
# -----------------------------------------------------------------------------
VECTOR_BACKEND=qdrant                   # qdrant | chroma
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
VECTOR_COLLECTION=aura_knowledge
SCHEMA_COLLECTION=aura_schemas          # technical/API schema registry vectors

# -----------------------------------------------------------------------------
# Semantic CAG Cache
# -----------------------------------------------------------------------------
CAG_SIMILARITY_THRESHOLD=0.92           # >= this score bypasses LLM inference
CAG_MAX_ENTRIES=2048

# -----------------------------------------------------------------------------
# Auth / RBAC
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
SESSION_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# MCP Integrations (Zoho / Odoo / Genesys)
# -----------------------------------------------------------------------------
ZOHO_MCP_URL=http://localhost:9001
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_WORKDRIVE_SCHEMA_FOLDER=

ODOO_MCP_URL=http://localhost:9002
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

GENESYS_MCP_URL=http://localhost:9003
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Frontend (Next.js) — exposed values must be prefixed NEXT_PUBLIC_
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change-me-too
NEXTAUTH_URL=http://localhost:3000
